{
  "name": "sontube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "dev:lan": "next dev -H 0.0.0.0 -p 3000",
    "start": "next start -H 127.0.0.1 -p 3000",
    "build": "prisma generate && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:web": "node scripts/verify-web.mjs",
    "verify:android:logic": "node scripts/verify-android-logic.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "auth:hash": "node scripts/hash-admin-password.mjs",
    "ops:preflight": "node --env-file-if-exists=.env scripts/check-production-env.mjs",
    "ops:backup": "node --env-file-if-exists=.env scripts/backup-restore.mjs backup",
    "ops:backup:dry-run": "node --env-file-if-exists=.env scripts/backup-restore.mjs backup --dry-run",
    "ops:backup:verify": "node --env-file-if-exists=.env scripts/backup-restore.mjs verify",
    "ops:restore": "node --env-file-if-exists=.env scripts/backup-restore.mjs restore",
    "ops:restore:plan": "node --env-file-if-exists=.env scripts/backup-restore.mjs restore --dry-run",
    "ops:restore:force": "node --env-file-if-exists=.env scripts/backup-restore.mjs restore --force"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@prisma/client": "^6.10.1",
    "next": "^15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.58.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.34",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "ajv": "^6.15.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.4",
    "postcss": "^8.5.6",
    "prisma": "^6.10.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
