generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ThumbnailType {
  YOUTUBE
  CUSTOM
  PLACEHOLDER
}

enum SafetyStatus {
  PARENT_CHECKED
  NEEDS_REVIEW
  HIDDEN
}

enum PlayMode {
  SINGLE_THEN_CLOSE
  ALLOW_CONTINUE
}

enum KidsSignalType {
  LIKE
  REWATCH
  CURIOUS
  FUNNY
  TOO_HARD
  DISLIKE
  PLAYLIST
}

enum PaymentRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
  REFUND_REQUESTED
  REFUNDED
  PARTIAL_REFUNDED
}

enum FamilySubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionGrantStatus {
  ACTIVE
  CANCELLED
}

enum PaymentRefundStatus {
  REQUESTED
  COMPLETED
  REJECTED
}

enum PaymentActorType {
  PARENT
  SUPERADMIN
  SYSTEM
}

enum PaymentAuditAction {
  PAYMENT_REQUESTED
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
  PAYMENT_EXPIRED
  REFUND_REQUESTED
  REFUND_REJECTED
  REFUND_COMPLETED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_EXTENDED
  ADMIN_MEMO_UPDATED
}

model Family {
  id              String              @id @default(cuid())
  name            String
  wifiRequired    Boolean             @default(true)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  users           ParentUser[]
  videos          Video[]
  channels        Channel[]
  tags            Tag[]
  appAccessKeys   AppAccessKey[]
  paymentRequests PaymentRequest[]
  subscription    FamilySubscription?
  grants          SubscriptionGrant[]
}

model ParentUser {
  id               String          @id @default(cuid())
  familyId         String
  email            String          @unique
  displayName      String
  passwordHash     String
  sessionVersion   Int             @default(1)
  isActive         Boolean         @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  family           Family          @relation(fields: [familyId], references: [id], onDelete: Restrict)
  paymentRequests  PaymentRequest[]
  requestedRefunds PaymentRefund[] @relation("RefundRequestedBy")

  @@index([familyId])
}

model Video {
  id                  String        @id @default(cuid())
  familyId            String?
  channelId           String?
  youtubeVideoId      String
  originalUrl          String
  title               String
  description         String?
  searchKeywords      String?
  durationText        String?
  thumbnailType       ThumbnailType @default(YOUTUBE)
  youtubeThumbnailUrl String?
  customThumbnailPath String?
  safetyStatus        SafetyStatus  @default(NEEDS_REVIEW)
  isPublished         Boolean       @default(false)
  isLitePublished     Boolean       @default(false)
  liteSortOrder       Int           @default(0)
  isParentRecommended Boolean       @default(false)
  parentRecommendedAt DateTime?
  playMode            PlayMode      @default(SINGLE_THEN_CLOSE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  family              Family?       @relation(fields: [familyId], references: [id], onDelete: Restrict)
  channel             Channel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  tags                VideoTag[]
  kidSignals          KidsVideoSignal[]

  @@unique([familyId, youtubeVideoId])
  @@index([familyId])
  @@index([channelId])
  @@index([isLitePublished, isPublished, safetyStatus, liteSortOrder])
}

model Channel {
  id             String   @id @default(cuid())
  familyId       String
  displayName    String
  normalizedName String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  family         Family   @relation(fields: [familyId], references: [id], onDelete: Restrict)
  videos         Video[]

  @@unique([familyId, normalizedName])
  @@index([familyId, isActive])
}

model Tag {
  id          String     @id @default(cuid())
  familyId    String?
  name        String
  slug        String
  color       String?
  icon        String?
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  usageCount  Int        @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  family      Family?    @relation(fields: [familyId], references: [id], onDelete: Restrict)
  videos      VideoTag[]

  @@unique([familyId, slug])
  @@index([familyId])
}

model VideoTag {
  videoId    String
  tagId      String
  assignedAt DateTime @default(now())
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
}

model KidsVideoSignal {
  id        String         @id @default(cuid())
  videoId   String
  clientKey String
  type      KidsSignalType
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  video     Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, clientKey, type])
  @@index([type])
  @@index([videoId])
  @@index([updatedAt])
}

model AppAccessKey {
  id             String    @id @default(cuid())
  familyId       String?
  name           String
  keyHash        String    @unique
  keyPrefix      String
  installationId String?   @unique
  isActive       Boolean   @default(true)
  trialStartedAt DateTime  @default(now())
  trialEndsAt    DateTime
  paidUntil      DateTime?
  lastSyncedAt   DateTime?
  registeredAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  family         Family?   @relation(fields: [familyId], references: [id], onDelete: Restrict)

  @@index([keyPrefix])
  @@index([familyId])
  @@index([trialEndsAt])
  @@index([paidUntil])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentPlan {
  id           String           @id @default(cuid())
  code         String           @unique
  name         String
  description  String?
  priceKrw     Int
  durationDays Int
  isActive     Boolean          @default(false)
  displayOrder Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  requests     PaymentRequest[]
}

model PaymentRequest {
  id                   String               @id @default(cuid())
  requestNo            String               @unique
  familyId             String
  requestedById        String
  planId               String
  planCodeSnapshot     String
  planNameSnapshot     String
  amountKrw            Int
  durationDaysSnapshot Int
  depositorName        String
  expectedDepositDate  String?
  requestedAt          DateTime             @default(now())
  status               PaymentRequestStatus @default(PENDING)
  pendingKey           String?              @unique
  confirmedAt          DateTime?
  confirmedBy          String?
  receivedAmountKrw    Int?
  receivedDate         String?
  rejectedAt           DateTime?
  rejectedBy           String?
  expiredAt            DateTime?
  refundRequestedAt    DateTime?
  refundedAt           DateTime?
  refundedBy           String?
  refundAmountKrw      Int                  @default(0)
  userMemo             String?
  adminMemo            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  family               Family               @relation(fields: [familyId], references: [id], onDelete: Restrict)
  requestedBy          ParentUser           @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  plan                 PaymentPlan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  grant                SubscriptionGrant?
  refunds              PaymentRefund[]
  auditLogs            PaymentAuditLog[]

  @@index([familyId, status])
  @@index([requestedById, requestedAt])
  @@index([requestedAt])
}

model FamilySubscription {
  id        String                   @id @default(cuid())
  familyId  String                   @unique
  startsAt  DateTime
  expiresAt DateTime
  status    FamilySubscriptionStatus @default(ACTIVE)
  version   Int                      @default(1)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  family    Family                   @relation(fields: [familyId], references: [id], onDelete: Restrict)
  grants    SubscriptionGrant[]
}

model SubscriptionGrant {
  id               String                  @id @default(cuid())
  familyId         String
  subscriptionId   String
  paymentRequestId String                  @unique
  startsAt         DateTime
  expiresAt        DateTime
  durationDays     Int
  status           SubscriptionGrantStatus @default(ACTIVE)
  cancelledAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  family           Family                  @relation(fields: [familyId], references: [id], onDelete: Restrict)
  subscription     FamilySubscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  paymentRequest   PaymentRequest          @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)

  @@index([familyId, status])
  @@index([subscriptionId, expiresAt])
}

model PaymentRefund {
  id               String              @id @default(cuid())
  paymentRequestId String
  requestedById    String?
  status           PaymentRefundStatus @default(REQUESTED)
  amountKrw        Int
  reason           String?
  requestedAt      DateTime            @default(now())
  processedAt      DateTime?
  processedBy      String?
  adminMemo        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  paymentRequest   PaymentRequest      @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)
  requestedBy      ParentUser?         @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([paymentRequestId, status])
  @@index([requestedById])
}

model PaymentAuditLog {
  id               String                @id @default(cuid())
  paymentRequestId String
  actorType        PaymentActorType
  actorId          String?
  action           PaymentAuditAction
  previousStatus   PaymentRequestStatus?
  nextStatus       PaymentRequestStatus?
  memo             String?
  createdAt        DateTime              @default(now())
  paymentRequest   PaymentRequest        @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)

  @@index([paymentRequestId, createdAt])
  @@index([actorType, actorId])
}

model SuperAdminAuditLog {
  id             String   @id @default(cuid())
  action         String
  actorId        String
  targetFamilyId String?
  targetUserId   String?
  metadataJson   String?
  createdAt      DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetFamilyId])
  @@index([targetUserId])
}
