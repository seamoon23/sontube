DATABASE_URL="file:./dev.db"

# 보호자 bootstrap 계정과 세션
SESSION_SECRET="replace-with-a-long-random-parent-session-secret"
ADMIN_PASSWORD_HASH=""
PARENT_BOOTSTRAP_EMAIL="parent@sontube.local"
PARENT_BOOTSTRAP_FAMILY_NAME="SonTube 가족"

# 최종관리자: 보호자와 다른 로그인 ID, 비밀번호, 세션 비밀키를 사용하세요.
SUPERADMIN_LOGIN_ID="owner"
SUPERADMIN_PASSWORD_HASH=""
SUPERADMIN_SESSION_SECRET="replace-with-a-separate-long-superadmin-secret"

# 사업자 계좌이체 안내: 실제 값은 운영 서버의 비밀 환경변수에만 저장하세요.
PAYMENT_BUSINESS_NAME=""
PAYMENT_BUSINESS_NUMBER=""
PAYMENT_BANK_NAME=""
PAYMENT_ACCOUNT_NUMBER=""
PAYMENT_ACCOUNT_HOLDER=""
PAYMENT_CONFIRMATION_NOTICE="입금 확인은 영업일 기준 1일 안에 처리됩니다."
PAYMENT_SUPPORT_CONTACT=""
PAYMENT_REFUND_POLICY=""

# YouTube 또는 Google API 키는 추가하지 않습니다.
# 보호자 비밀번호 해시:
# npm run auth:hash -- <parent-password> <SESSION_SECRET>
# 최종관리자 비밀번호 해시:
# npm run auth:hash -- <superadmin-password> <SUPERADMIN_SESSION_SECRET>